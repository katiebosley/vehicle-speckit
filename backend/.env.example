DB_HOST=localhost
DB_USER=root
DB_PW=
DB_NAME=vehicle-t2
AUTH_SECRET=change-me-in-production
# Google Cloud OAuth client ID (same value as frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
PORT=3200
NODE_ENV=development
# In development, schema changes auto-apply on server start (set false to disable).
SEQUELIZE_SYNC_ALTER=true
