{
  "name": "vehicle-speckit",
  "version": "1.0.0",
  "private": true,
  "description": "Spec-driven app — monorepo root (deploy scripts orchestrate frontend/ and backend/)",
  "homepage": "https://github.com/katiebosley/vehicle-speckit#readme",
  "bugs": {
    "url": "https://github.com/katiebosley/vehicle-speckit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katiebosley/vehicle-speckit.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build:frontend": "npm run build --prefix frontend",
    "bundle:frontend": "npm run bundle --prefix frontend",
    "bundle:backend": "npm run bundle --prefix backend",
    "bundle": "npm run bundle:backend && npm run build:frontend && npm run bundle:frontend",
    "bundle:frontend:full": "node scripts/bundle-frontend.mjs",
    "bundle:backend:full": "node scripts/bundle-backend.mjs",
    "bundle:all": "node scripts/bundle-all.mjs",
    "test": "npm run test --prefix backend && npm run test --prefix frontend",
    "test:backend": "npm run test --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "specs:pdf": "node scripts/export-specs-pdf.mjs",
    "specs:pdf:app": "node scripts/export-app-specs-pdf.mjs",
    "specs:pdf:setup": "npx puppeteer browsers install chrome",
    "writing-guides:pdf": "node scripts/export-writing-guides-pdf.mjs",
    "agility:export": "node scripts/export-agility-import.mjs --project \"OC Vehicle Scheduling\"",
    "agility:push": "node scripts/push-agility-api.mjs",
    "agility:push:dry-run": "node scripts/push-agility-api.mjs --dry-run",
    "agility:verify": "node scripts/push-agility-api.mjs --verify"
  },
  "devDependencies": {
    "md-mermaid-pdf": "^0.1.7"
  }
}
